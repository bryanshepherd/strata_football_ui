    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="record" type="xs:string" use="required"/>
    <xs:attribute name="abb" type="xs:string" use="required"/>
    <xs:attribute name="conf-record" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ScoreType">
    <xs:attribute name="V" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="H" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="vh" type="HomeVisitorType" use="optional"/>
    <xs:attribute name="team" type="xs:string" use="optional"/>
    <xs:attribute name="qtr" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="clock" type="xs:string" use="optional"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="scorer" type="xs:string" use="optional"/>
    <xs:attribute name="yds" type="xs:integer" use="optional"/>
    <xs:attribute name="passer" type="xs:string" use="optional"/>
    <xs:attribute name="pattype" type="xs:string" use="optional"/>
    <xs:attribute name="patres" type="xs:string" use="optional"/>
    <xs:attribute name="patby" type="xs:string" use="optional"/>
    <xs:attribute name="how" type="xs:string" use="optional"/>
    <xs:attribute name="plays" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="top" type="xs:string" use="optional"/>
    <xs:attribute name="drive" type="xs:string" use="optional"/>
    <xs:attribute name="driveindex" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="vscore" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="hscore" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="final" type="YesNoType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ScoresType">
    <xs:sequence>
      <xs:element name="score" type="ScoreType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FieldGoalAttemptType">
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="team" type="xs:string" use="required"/>
    <xs:attribute name="qtr" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="clock" type="xs:string" use="required"/>
    <xs:attribute name="kicker" type="xs:string" use="required"/>
    <xs:attribute name="distance" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FieldGoalAttemptsType">
    <xs:sequence>
      <xs:element name="fga" type="FieldGoalAttemptType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DriveType">
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="team" type="xs:string" use="required"/>
    <xs:attribute name="driveindex" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="start" type="xs:string" use="required"/>
    <xs:attribute name="end" type="xs:string" use="required"/>
    <xs:attribute name="plays" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="yards" type="xs:integer" use="required"/>
    <xs:attribute name="top" type="xs:string" use="required"/>
    <xs:attribute name="start_qtr" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="start_time" type="xs:string" use="required"/>
    <xs:attribute name="start_spot" type="xs:string" use="required"/>
    <xs:attribute name="start_how" type="xs:string" use="required"/>
    <xs:attribute name="end_qtr" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="end_time" type="xs:string" use="required"/>
    <xs:attribute name="end_spot" type="xs:string" use="required"/>
    <xs:attribute name="end_how" type="xs:string" use="required"/>
    <xs:attribute name="rz" type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DrivesType">
    <xs:sequence>
      <xs:element name="drive" type="DriveType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BreakupPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_bu; bu means pass breakup. Identifies the defender credited
        with breaking up the pass.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FieldGoalPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_fg; fg means field goal. Identifies the kicker, attempt
        distance, result, and whether the attempt produced a score.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="distance" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
    <xs:attribute name="score" type="YesNoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="FumblePlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_fumb; fumb means fumble. Identifies the player who fumbled,
        the fumble spot, and the recovering player and team when known.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="at" type="xs:string" use="optional"/>
    <xs:attribute name="frvh" type="HomeVisitorType" use="optional"/>
    <xs:attribute name="frname" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="KickoffPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_ko; ko means kickoff. Identifies the kicker, kick distance,
        result, and fair-catch player when applicable.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="gain" type="xs:integer" use="required"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
    <xs:attribute name="fc" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ReturnPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_kr and p_pr. kr means kickoff return and pr means punt return.
        Identifies the returner and return gain.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="gain" type="xs:integer" use="required"/>
  </xs:complexType>

  <xs:complexType name="PassPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_pa; pa means passer. Identifies the passer and, when known,
        the receiver, result, and gain associated with the passing action.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="qb" type="xs:string" use="required"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
    <xs:attribute name="rcv" type="xs:string" use="optional"/>
    <xs:attribute name="gain" type="xs:integer" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PatPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_pat; pat means point-after attempt. Identifies the credited
        player, attempt type, quarterback when applicable, result, and whether
        the attempt produced a score.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="qb" type="xs:string" use="optional"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
    <xs:attribute name="score" type="YesNoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="PenaltyPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_pn; pn means penalty. Identifies the penalized team and, when
        known, player along with the penalty code, enforcement result, spot,
        and yards.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="code" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="result" type="xs:string" use="required"/>
    <xs:attribute name="at" type="xs:string" use="required"/>
    <xs:attribute name="yards" type="xs:integer" use="required"/>
  </xs:complexType>

  <xs:complexType name="PuntPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_pu; pu means punt. Identifies the punter and punt distance,
        including inside-the-20, touchback, and out-of-bounds indicators.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="gain" type="xs:integer" use="required"/>
    <xs:attribute name="in20" type="YesNoType" use="required"/>
    <xs:attribute name="tb" type="YesNoType" use="required"/>
    <xs:attribute name="ob" type="YesNoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="NamedPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_qbh; qbh means quarterback hurry. Identifies the defender
        credited with hurrying the quarterback.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RushPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_ru; ru means rusher. Identifies the ball carrier and rushing
        gain associated with the play.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="gain" type="xs:integer" use="required"/>
  </xs:complexType>

  <xs:complexType name="TacklePlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_tk; tk means tackler. Identifies a tackling actor and whether
        the credit is an assist, sack, tackle for loss, or forced fumble.
        Multiple p_tk elements may identify multiple credited tacklers.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="sack" type="YesNoType" use="required"/>
    <xs:attribute name="tfl" type="YesNoType" use="required"/>
    <xs:attribute name="ff" type="YesNoType" use="required"/>
    <xs:attribute name="assist" type="YesNoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="TimeoutPlayType">
    <xs:annotation>
      <xs:documentation>
        Used by p_to; to means timeout. Identifies the team charged with the
        timeout.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="team" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:group name="PlayActionGroup">
    <xs:annotation>
      <xs:documentation>
        Optional actor-detail enhancements attached to a play. These children
        describe the people or teams involved and what each did; they complement
        the parent play record rather than replace it. StatBroadcast uses these
        details to associate a player with every play in which that player was
        involved, enabling player-to-play navigation. A play may contain several
        actor-detail children, including repeated roles such as tacklers.

        Confirmed abbreviations: p_bu pass breakup, p_fg field goal, p_fumb
        fumble, p_ko kickoff, p_kr kickoff return, p_pa passer, p_pat
        point-after attempt, p_pn penalty, p_pr punt return, p_pu punt, p_qbh
        quarterback hurry, p_ru rusher, p_tk tackler, and p_to timeout.
      </xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="p_bu" type="BreakupPlayType"/>
      <xs:element name="p_fg" type="FieldGoalPlayType"/>
      <xs:element name="p_fumb" type="FumblePlayType"/>
      <xs:element name="p_ko" type="KickoffPlayType"/>
      <xs:element name="p_kr" type="ReturnPlayType"/>
      <xs:element name="p_pa" type="PassPlayType"/>
      <xs:element name="p_pat" type="PatPlayType"/>
      <xs:element name="p_pn" type="PenaltyPlayType"/>
      <xs:element name="p_pr" type="ReturnPlayType"/>
      <xs:element name="p_pu" type="PuntPlayType"/>
      <xs:element name="p_qbh" type="NamedPlayType"/>
      <xs:element name="p_ru" type="RushPlayType"/>
      <xs:element name="p_tk" type="TacklePlayType"/>
      <xs:element name="p_to" type="TimeoutPlayType"/>
    </xs:choice>
  </xs:group>

  <xs:complexType name="PlayType">
    <xs:group ref="PlayActionGroup" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="hasball" type="xs:string" use="required"/>
    <xs:attribute name="down" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="togo" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="spot" type="TeamYardlineSpotType" use="required"/>
    <xs:attribute name="context" type="PlayContextType" use="required"/>
    <xs:attribute name="playid" type="PlayIdentifierType" use="required"/>
    <xs:attribute name="type" type="PlayTypeCodeType" use="required"/>
    <xs:attribute name="clock" type="xs:string" use="optional"/>
    <xs:attribute name="tokens" type="LegacyTokensType" use="required"/>
    <xs:attribute name="text" type="xs:string" use="required"/>
    <xs:attribute name="newcontext" type="PlayContextType" use="required"/>
    <xs:attribute name="first" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          Legacy GeniusSports/NLS first-down classification. Intended values
          appear to be R for rush, P for pass, and E for penalty, but 40749.XML
          also contains first="O" and marks several rushing first downs as
          first="P". Consumers must not treat this field as authoritative.
          Strata producers should omit it unless a reliable external contract
          is established. It remains optional and unrestricted only so legacy
          source documents can be imported and validated without data loss.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="score" type="YesNoType" use="optional"/>
    <xs:attribute name="vscore" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="hscore" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="ob" type="YesNoType" use="optional"/>
    <xs:attribute name="turnover" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DriveStartType">
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="spot" type="TeamYardlineSpotType" use="required"/>
    <xs:attribute name="clock" type="xs:string" use="required"/>
    <xs:attribute name="driveIndex" type="xs:string" use="required"/>
    <xs:attribute name="poss" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DriveSummaryType">
    <xs:attribute name="plays" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="yards" type="xs:integer" use="required"/>
    <xs:attribute name="top" type="xs:string" use="required"/>
    <xs:attribute name="driveindex" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="CommentType">
    <xs:attribute name="text" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="QuarterSummaryType">
    <xs:group ref="CompleteTeamStatsGroup"/>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="QuarterType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="comment" type="CommentType"/>
      <xs:element name="drivestart" type="DriveStartType"/>
      <xs:element name="play" type="PlayType"/>
      <xs:element name="drivesum" type="DriveSummaryType"/>
      <xs:element name="score" type="ScoreType"/>
      <xs:element name="endqtr" type="EmptyType"/>
      <xs:element name="qtrsummary" type="QuarterSummaryType"/>
    </xs:choice>
    <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="text" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DownToGoType">
    <xs:annotation>
      <xs:documentation>
        Current live status. flag="Y" means a queued penalty is waiting or the
        operator is working on an immediate penalty. review="Y" means the
        previous play is under coach's-challenge or booth review. Both
        attributes are omitted when false; flag="N" and review="N" are invalid.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="hasball" type="HomeVisitorType" use="required"/>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Code of the team currently possessing the ball. hasball identifies
          the same team by its V/H side.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="down" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="togo" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="spot" type="TeamYardlineSpotType" use="required"/>
    <xs:attribute name="context" type="PlayContextType" use="required"/>
    <xs:attribute name="qtr" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="clock" type="xs:string" use="required"/>
    <xs:attribute name="vtoh" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation>
          Running count of timeouts called by the visiting team in the current
          half. The value counts upward; it is not the number of timeouts
          remaining. TOH means timeout half.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="htoh" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation>
          Running count of timeouts called by the home team in the current half.
          The value counts upward; it is not the number of timeouts remaining.
          TOH means timeout half.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lastplay" type="xs:string" use="required"/>
    <xs:attribute name="flag" type="PresentYesType" use="optional"/>
    <xs:attribute name="review" type="PresentYesType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PlaysType">
    <xs:sequence>
      <xs:element name="qtr" type="QuarterType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="downtogo" type="DownToGoType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="format" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DnpPlayerType">
    <xs:attribute name="uni" type="xs:string" use="required"/>
    <xs:attribute name="code" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="checkname" type="xs:string" use="required"/>
    <xs:attribute name="gp" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="class" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DnpType">
    <xs:sequence>
      <xs:element name="player" type="DnpPlayerType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="LongPlayType">
    <xs:attribute name="vh" type="HomeVisitorType" use="required"/>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="yds" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="play" type="xs:string" use="required"/>
    <xs:attribute name="players" type="xs:string" use="required"/>
    <xs:attribute name="td" type="YesNoType" use="required"/>
  </xs:complexType>

  <xs:complexType name="LongPlaysType">
    <xs:sequence>
      <xs:element name="longplays" type="LongPlayType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="threshold" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:element name="fbgame">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="venue" type="VenueType"/>
        <xs:element name="team" type="TeamType" minOccurs="2" maxOccurs="2"/>
        <xs:element name="scores" type="ScoresType"/>
        <xs:element name="fgas" type="FieldGoalAttemptsType"/>
        <xs:element name="drives" type="DrivesType"/>
        <xs:element name="plays" type="PlaysType"/>
        <xs:element name="dnp" type="DnpType" minOccurs="0" maxOccurs="2"/>
        <xs:element name="longplays" type="LongPlaysType"/>
      </xs:sequence>
      <xs:attribute name="source" type="xs:string" use="required"/>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="generated" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
