@@ -1,10 +1,23 @@
-export const validateYardLine = (value) => /^(H|V)\d{2}|50$/.test(value);
+// Enforce H## / V## with 01–50, or '50' (midfield). Disallow 00 and >50 by default.
+export const validateYardLine = (value, { allowEndZones = false } = {}) => {
+  const s = String(value ?? '').trim().toUpperCase();
+  if (s === '50') return true;
+  const m = /^([HV])(\d{2})$/.exec(s);
+  if (!m) return false;
+  const n = parseInt(m[2], 10);
+  if (allowEndZones) {
+    // If you choose to allow 00 as an end-zone marker, uncomment:
+    // return n >= 0 && n <= 50;
+    return n >= 1 && n <= 50; // default even with flag
+  }
+  return n >= 1 && n <= 50;
+};

 export const normalizeYardLine = (value) => {
-  if (value === '50') return '50';
-  const team = value[0]?.toUpperCase();
-  const num = String(parseInt(value.slice(1), 10)).padStart(2, '0');
-  return (team === 'H' || team === 'V') ? `${team}${num}` : value;
+  if (value == null) return '';
+  const s = String(value).trim().toUpperCase();
+  if (s === '50') return '50';
+  const m = /^([HV])(\d{1,2})$/.exec(s);
+  return m ? `${m[1]}${String(parseInt(m[2], 10)).padStart(2, '0')}` : s;
 };

 export const validateJerseyNumber = (num) => /^\d{1,2}$/.test(String(num));
diff --git a/src/utils/apiDataContract.ts b/src/utils/apiDataContract.ts
index 7777777..8888888 100644
--- a/src/utils/apiDataContract.ts
+++ b/src/utils/apiDataContract.ts
@@ -1,6 +1,38 @@
-export function frontendToBackendPlay(p: any) {
-  // original simple mapping
-  return {};
+// Helpers
+const num = (x: any) => (x === null || x === undefined || x === '' ? undefined : Number(x));
+const mmss = (s: any) => String(s ?? '');
+
+export function normalizePossession(x: any): 'H' | 'V' {
+  if (x === 'H' || x === 'V') return x;
+  if (x === 'home') return 'H';
+  if (x === 'visitor') return 'V';
+  console.warn('[contract] Unknown possession:', x);
+  throw new Error('Invalid possession value');
+}
+
+export function clockToSeconds(s: string): number {
+  const m = /^\s*(\d{1,2}):(\d{2})\s*$/.exec(mmss(s));
+  if (!m) throw new Error('Invalid clock MM:SS');
+  return Number(m[1]) * 60 + Number(m[2]);
+}
+
+export function secondsToClock(n: number): string {
+  const t = Number(n || 0);
+  const m = Math.floor(t / 60);
+  const s = t % 60;
+  return `${m}:${String(s).padStart(2, '0')}`;
+}
+
+export function frontendToBackend(p: any) {
+  return {
+    period: num(p.period) ?? num(p.quarter),
+    time_remaining: p.time_remaining ?? clockToSeconds(p.clock),
+    possession: normalizePossession(p.possession),
+    distance: num(p.distance) ?? num(p.yardsToGo),
+    yards: num(p.yards) ?? num(p.yardsGained),
+    is_first_down: p.is_first_down ?? p.isFirstDown ?? false,
+    primary_player_id: p.primary_player_id ?? p.primaryPlayerID,
+  };
 }
+
+export const frontendToBackendPlay = frontendToBackend;
+
+export function backendToFrontend(b: any) {
+  return {
+    quarter: num(b.period),
+    clock: secondsToClock(b.time_remaining),
+    possession: b.possession === 'H' ? 'home' : 'visitor',
+    yardsGained: num(b.yards),
+    isFirstDown: !!b.is_first_down,
+    primaryPlayerID: b.primary_player_id,
+  };
+}
+
+export const backendToFrontendState = backendToFrontend;
